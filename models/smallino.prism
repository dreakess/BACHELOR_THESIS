

// maze example (POMDP)
// slightly extends that presented in
// Littman, Cassandra and Kaelbling
// Learning policies for partially observable environments: Scaling up  
// Technical Report CS, Brown University
// gxn 29/01/16

// state space (value of variable "s")

//  0  1  2  3  4
//  5     6     7




// 6 is the target

pomdp

// can observe the walls and target
observables
	o
endobservables


// o=1 - west and north walls (s0) {giallo}
// o=2 - north and south walls (s1 and s3) {grigio}
// o=3 - north wall (s2) {rosso} {final state}
// o=4 - east and north way (s4) {arancione}	

const double rew = 10; 

module maze

	s : [0..4] init 0;
	o : [1..4] init 1;

	
	// randomised initialisation
	//[] s=-1 -> 1/8 : (s'=0) & (o'=1) 
	//+ 1/8 : (s'=1) & (o'=2) 
	//+ 1/8 : (s'=2) & (o'=3) 
	//+ 1/8 : (s'=3) & (o'=2) 
	//+ 1/8 : (s'=4) & (o'=4) 
	//+ 1/8 : (s'=5) & (o'=5) 
	//+ 1/8 : (s'=6) & (o'=6) 
	//+ 1/8 : (s'=7) & (o'=5); 


	
	[east] s=0 -> 1/2 : (s'=0) + 1/2 : (s'=1) & (o'=2);
	[west] s=0 -> 1/2 : (s'=0) + 1/2 : (s'=1) & (o'=2);
	[north] s=0 -> 1/2 : (s'=0) + 1/2 : (s'=1) & (o'=2);
	[south] s=0 -> 1/2 : (s'=0) + 1/2 : (s'=1) & (o'=2);

	[east] s=1 -> 2/10 : (s'=2) & (o'=3) + 8/10 : (s'=0) & (o'=1);
	[west] s=1 -> 2/10 : (s'=0) & (o'=1) + 8/10 : (s'=2) & (o'=3);
	[north] s=1 -> 8/10 : (s'=2) & (o'=3) + 2/10 : (s'=0) & (o'=1);
	[south] s=1 -> 2/10 : (s'=2) & (o'=3) + 8/10 : (s'=0) & (o'=1);

	[east] s=3 -> 1/10 : (s'=4) & (o'=4) + 9/10 : (s'=2) & (o'=3);
	[west] s=3 -> 9/10 : (s'=2) & (o'=3) + 1/10 : (s'=4) & (o'=4);
	[north] s=3 -> 2/3 : (s'=2) & (o'=3) + 1/3 : (s'=4) & (o'=4);
	[south] s=3 -> 1/4 : (s'=4) & (o'=4) + 3/4 : (s'=2) & (o'=3);

	[east] s=4 -> 1/2 : (s'=3) & (o'=2) + 1/2 : (s'=4);
	[west] s=4 -> 1/2 : (s'=3) & (o'=2) + 1/2 : (s'=4);
	[north] s=4 -> 1/2 : (s'=3) & (o'=2) + 1/2 : (s'=4);
	[south] s=4 -> 1/2 : (s'=3) & (o'=2) + 1/2 : (s'=4);

	[done] s=2 -> true;  

endmodule




// target observation
label "target" = o=3;
