

// maze example (POMDP)
// slightly extends that presented in
// Littman, Cassandra and Kaelbling
// Learning policies for partially observable environments: Scaling up  
// Technical Report CS, Brown University
// gxn 29/01/16

// state space (value of variable "s")

//  0  1  2  3  4
//        6     




// 6 is the target

pomdp

// can observe the walls and target
observables
	o
endobservables


// o=0 - west and north walls (s0) {giallo}
// o=1 - north and south walls (s1 and s3) {grigio}
// o=2 - north wall (s2) {rosso}
// o=3 - east and north way (s4) {arancione}
// o=4 - the target (s6) {verde}

const double rew = 10; 

module maze

	s : [0..7] init 0; 
	o : [0..4] init 0;
	
	
	// randomised initialisation
	//[] s=-1 -> 1/8 : (s'=0) & (o'=1) 
	// + 1/8 : (s'=1) & (o'=2) 
	 //+ 1/8 : (s'=2) & (o'=3) 
	 //+ 1/8 : (s'=3) & (o'=2) 
	 //+ 1/8 : (s'=4) & (o'=4) 
	 //+ 1/8 : (s'=5) & (o'=5) 
	 //+ 1/8 : (s'=6) & (o'=6) 
	 //+ 1/8 : (s'=7) & (o'=5); 

	
	// moving around the maze
	
	[east] s=0 -> (s'=1) & (o'=1);

	// quando mi trovo nello stato s0 e mi sposto ad est di uno vuol dire che mi fermo in s1 e quindi devo legarli 
	// l' osservazione che ho rispetto a s1, ovvero che ho muri sopra e sotto 

	[west] s=0 -> (s'=1) & (o'=1);
	[north] s=0 -> (s'=1) & (o'=1);
	[south] s=0 -> (s'=1) & (o'=1);

	[east] s=1 -> 8/10 : (s'=2) & (o'=2) + 2/10 : (s'=0) & (o'=0);
	[west] s=1 -> 4/10 : (s'=0) & (o'=0) + 6/10 : (s'=2) & (o'=2);
	[north] s=1 -> 1/2 : (s'=2) & (o'=2) + 1/2 : (s'=0) & (o'=0);
	[south] s=1 -> 2/3 : (s'=2) & (o'=2) + 1/3 : (s'=0) & (o'=0);

	[east] s=2 -> 8/10 : (s'=3) & (o'=1) + 2/10 : (s' =1) & (o'=1);
	[west] s=2 -> 8/10 : (s'=1) & (o'=1) + 2/10 : (s' =6) & (o'=4);
	[north] s=2 -> 1/2 : (s'=6) & (o'=4) + 1/2 : (s'=3) & (o'=1);
	[south] s=2 -> 9/10 : (s'=6) & (o'=4) + 1/10 : (s'=3) & (o'=1);

	[east] s=3 -> 7/10 : (s'=4) & (o'=3) + 3/10 : (s'=2) & (o'=2);
	[west] s=3 -> 6/10 : (s'=2) & (o'=2) + 4/10 : (s'=4) & (o'=3);
	[north] s=3 -> 1/2 : (s'=2) & (o'=2) + 1/2 : (s'=4) & (o'=3);
	[south] s=3 -> 2/10 : (s'=4) & (o'=3) + 8/10 : (s'=2) & (o'=2);

	[east] s=4 -> (s'=3) & (o'=1);
	[west] s=4 -> (s'=3) & (o'=1);
	[north] s=4 -> (s'=3) & (o'=1);
	[south] s=4 -> (s'=3) & (o'=1);

	[done] s=5 -> true;


	// loop when we reach the target
	// [done] s=6 -> true;
	// [done] s=7 -> true;  

endmodule

// reward structure (number of steps to reach the target)
rewards "step"

	[east] true : 1;
	[west] true : 1;
	[north] true : 1;
	[south] true : 1;

endrewards

rewards "power"

	[east] true : -1;
	[west] true : 1;
	[north] true : 1;
	[south] true : 1;

endrewards




// target observation
label "goal" = o=4;
label "bad" = o=1;
